<?xml version="1.0" encoding="utf-8"?>
<!--
  Optimizely CMS 13 protected-module manifest for the Variations Auditor addon.

  loadFromBin="true"  - the addon assemblies are delivered by the NuGet package into the consuming
                        site's bin folder (lib/net10.0/...), NOT into a per-module bin folder, so the
                        shell must resolve them from the application bin. The feature code (controllers,
                        InitializableModule, MenuProvider, embedded UI) lives in
                        PiNo.Labs.VariationsAuditor.Core.dll, which the addon package bundles into lib/.
  The module is also self-registered at runtime via ProtectedModuleOptions in
  VariationsAuditorInitialization, so discovery never depends on the consuming site's configuration.

  NOTE: there is intentionally NO clientResourceRelativePath here. The React UI is served from an
  EmbeddedFileProvider over the Core assembly (see VariationsAuditorStaticFilesStartup), NOT from the
  module's clientResources folder, so a versioned resource path would be misleading and could drift
  from the package Version.
-->
<module loadFromBin="true"
        productName="PiNo.Labs.VariationsAuditor"
        viewEngine="Razor"
        viewRecursionDepth="50">
  <assemblies>
    <add assembly="PiNo.Labs.VariationsAuditor.Core" />
  </assemblies>
  <!--
    Declare the shell client-module dependency on CMS so the shell loads this module's client manifest
    after the CMS client module (matches the documented Optimizely pattern and other add-ons, e.g. Geta
    NotFoundHandler). The module's UI itself is a same-origin React SPA rendered full-page inside the
    <platform-navigation /> shell chrome (no Dojo clientResources are shipped).
  -->
  <clientModule>
    <moduleDependencies>
      <add dependency="CMS" />
    </moduleDependencies>
  </clientModule>
</module>
